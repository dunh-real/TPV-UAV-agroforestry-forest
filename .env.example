# Copy thành `.env` rồi điền giá trị thật. `.env` đã được gitignore (secrets không lọt git).
# config.py tự nạp `.env` lúc import; docker compose cũng tự đọc `.env` để thay ${...}.

# Redis — REDIS_PASSWORD dùng cho compose (--requirepass) lẫn REDIS_URL của app (phải khớp).
REDIS_PASSWORD=changeme
REDIS_URL=redis://:changeme@localhost:6380/0

# MinIO / S3
MINIO_ENDPOINT=s3.example.com        # host (không kèm scheme); MINIO_SECURE=1 → HTTPS:443
MINIO_ACCESS_KEY=your-access-key
MINIO_SECRET_KEY=your-secret-key
MINIO_SECURE=1
MINIO_BUCKET=images
